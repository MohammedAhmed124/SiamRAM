# syntax=docker/dockerfile:1

# =============================================================================
# Dockerfile.jetson — run the SiamRAM submission on a Jetson Orin Nano
#                     (JetPack / L4T, ARM64)
#
# Why this is a separate Dockerfile from the normal x86 one:
# The Orin Nano is an ARM64 board and gets its CUDA, cuDNN, TensorRT, PyTorch
# and OpenCV from NVIDIA's L4T / JetPack stack, not from the usual x86 PyPI and
# CUDA wheels. So we start FROM an L4T PyTorch base image that already has all
# of that built for the Jetson, and we only pip-install the pure-Python packages
# on top of it (see requirements.jetson.txt). torch, torchvision and OpenCV come
# from the base on purpose, so we never overwrite the Jetson-native,
# GStreamer-enabled builds with the CPU-only PyPI ones.
#
# IMPORTANT — pick the base tag that matches YOUR JetPack version.
# Check the version on the device first:
#       cat /etc/nv_tegra_release
# then choose a matching tag:
#       JetPack 6.x  ->  L4T r36.x  ->  dustynv/l4t-ml:r36.2.0   (default)
#       JetPack 5.x  ->  L4T r35.x  ->  dustynv/l4t-ml:r35.4.1
# You can override it without editing this file:
#       docker build -f Dockerfile.jetson \
#           --build-arg L4T_BASE=dustynv/l4t-ml:r35.4.1 \
#           -t siamram-jetson .
#
# Why l4t-ml and not l4t-pytorch:
# l4t-ml bundles torch, torchvision, numpy, scipy, pandas AND OpenCV built with
# CUDA + GStreamer, so the hardware NVDEC decode path works out of the box and we
# barely have to pip-install anything. l4t-pytorch is lighter but does not always
# include OpenCV / the scientific stack, which would break the decode path. If
# you deliberately switch to l4t-pytorch, add opencv + scipy + pandas back to
# requirements.jetson.txt yourself. Either way the build self-check below tells
# you immediately if something the code needs is missing.
# =============================================================================

ARG L4T_BASE=dustynv/l4t-ml:r36.2.0
FROM ${L4T_BASE}

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# GStreamer command-line tools and the base/good/bad plugin sets. JetPack
# already ships NVIDIA's hardware decoder plugin (nvv4l2decoder); these packages
# provide the qtdemux / h264parse / videoconvert elements that the NVDEC
# pipeline in predictor.py is built from, plus gst-inspect-1.0, which the code
# calls to check whether the hardware decoder is actually present.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        libgstreamer1.0-0 \
        libgstreamer-plugins-base1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install only the pure-Python dependencies. torch / torchvision / opencv /
# numpy / pillow are intentionally absent from this file and come from the base
# image (the reasoning is spelled out in requirements.jetson.txt).
COPY requirements.jetson.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements.jetson.txt

# Fail the build LOUDLY if the environment is not actually Jetson-ready, so we
# find out now instead of in the middle of grading. We check that:
#   1) torch is a CUDA build (not the CPU-only ARM64 PyPI wheel),
#   2) OpenCV reports GStreamer: YES (otherwise NVDEC can never work, usually
#      because a pip opencv-python sneaked in and clobbered the base OpenCV),
#   3) the other heavy libraries import cleanly (this also catches a numpy ABI
#      mismatch, which would otherwise blow up at run time).
# We do NOT check torch.cuda.is_available() here because the GPU is not attached
# during 'docker build'; that is verified when the container actually runs.
RUN python3 - <<'PY'
import torch, cv2
print("torch:", torch.__version__, "| built against CUDA:", torch.version.cuda)
assert torch.version.cuda is not None, (
    "torch is a CPU-only build. Use an L4T PyTorch base image and do NOT "
    "pip install torch on a Jetson."
)
gst_lines = [l for l in cv2.getBuildInformation().splitlines() if "GStreamer" in l]
print("opencv:", cv2.__version__, "|", gst_lines[0].strip() if gst_lines else "GStreamer: (not listed)")
assert any("YES" in l for l in gst_lines), (
    "OpenCV was built WITHOUT GStreamer, so the NVDEC decode path cannot work. "
    "A pip opencv-python / opencv-python-headless most likely clobbered the "
    "base image's OpenCV."
)
import scipy, pandas, omegaconf, hydra, ultralytics  # noqa: F401
print("Jetson build verification passed.")
PY

COPY . .

# Default to an interactive shell. Run the evaluation with, for example:
#       python3 inference.py test.json public_test submission.csv
# (and remember to set runtime.use_nvdec: true in the config to actually use the
#  Jetson hardware decoder — see JETSON.md.)
CMD ["bash"]
