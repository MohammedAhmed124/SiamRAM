{
  "name": "SiamRAM (GPU)",
  "dockerComposeFile": ["../containers/docker-compose.gpu.yml"],
  "service": "gpu",
  "workspaceFolder": "/app",
  "overrideCommand": false,
  "runServices": ["gpu"],
  "postCreateCommand": "uv sync --frozen --group gpu",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "charliermarsh.ruff"]
    }
  }
}
