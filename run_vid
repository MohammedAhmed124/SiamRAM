#!/usr/bin/env python3
"""Play a dataset video by numeric ID from data/metadata/video_id_map.csv.

Usage:
    run_vid 222
"""

from __future__ import annotations

import argparse
import csv
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
DEFAULT_ID_MAP = BASE_DIR / "data" / "metadata" / "video_id_map.csv"
DEFAULT_MANIFEST = BASE_DIR / "data" / "metadata" / "contestant_manifest.json"
DEFAULT_DATA_DIR = BASE_DIR / "data"


def _normalize_id(value: str) -> str:
    value = value.strip()
    if not value or not value.isdigit():
        raise ValueError(f"video_id must be numeric, got: {value!r}")
    return str(int(value))


def _lookup_video_key(video_id: str, id_map_path: Path) -> str:
    if not id_map_path.exists():
        raise FileNotFoundError(f"ID map not found: {id_map_path}")

    with id_map_path.open("r", encoding="utf-8", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            raw_row_id = str(row.get("video_id", "")).strip()
            if not raw_row_id.isdigit():
                continue
            row_id = str(int(raw_row_id))
            if row_id == video_id:
                key = str(row.get("video_key", "")).strip()
                if key:
                    return key
                raise ValueError(f"video_key missing for video_id {video_id}")

    raise KeyError(f"video_id {video_id} not found in {id_map_path}")


def _load_manifest_entry(video_key: str, manifest_path: Path) -> dict:
    if not manifest_path.exists():
        raise FileNotFoundError(f"Manifest not found: {manifest_path}")

    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    for split_name in ("public_lb", "train"):
        split = manifest.get(split_name, {})
        if isinstance(split, dict) and video_key in split:
            entry = split[video_key]
            if isinstance(entry, dict):
                return entry
    raise KeyError(f"video_key {video_key!r} not found in manifest: {manifest_path}")


def _resolve_video_path(video_path_value: str, data_dir: Path) -> Path:
    raw = str(video_path_value or "").strip()
    if not raw:
        raise ValueError("video_path missing in manifest entry")

    path = Path(raw).expanduser()
    candidates: list[Path] = []

    if path.is_absolute():
        candidates.append(path)
    else:
        candidates.append((data_dir / path).resolve())
        candidates.append((BASE_DIR / path).resolve())

    normalized = raw.replace("\\", "/")
    if normalized.startswith("/app/"):
        candidates.append((BASE_DIR / normalized[len("/app/"):]).resolve())
    elif "/app/" in normalized:
        candidates.append((BASE_DIR / normalized.split("/app/", 1)[1]).resolve())

    for candidate in candidates:
        if candidate.exists():
            return candidate

    raise FileNotFoundError(
        "Could not locate video file. Tried:\n"
        + "\n".join(f"  - {c}" for c in candidates)
    )


def _play_with_external_player(video_path: Path) -> bool:
    players: list[tuple[str, list[str]]] = [
        ("ffplay", ["-autoexit", str(video_path)]),
        ("mpv", [str(video_path)]),
        ("vlc", ["--play-and-exit", str(video_path)]),
        ("xdg-open", [str(video_path)]),
    ]

    for binary, args in players:
        if not shutil.which(binary):
            continue
        completed = subprocess.run([binary, *args], cwd=str(BASE_DIR))
        if completed.returncode == 0:
            return True

    return False


def _has_gui_display() -> bool:
    return any(
        os.environ.get(name)
        for name in ("DISPLAY", "WAYLAND_DISPLAY", "MIR_SOCKET")
    )


def _play_with_opencv(video_path: Path, window_name: str) -> int:
    if not _has_gui_display():
        print(
            "No GUI display detected (DISPLAY/WAYLAND not set). "
            "Cannot open a video window in this shell.",
            file=sys.stderr,
        )
        return 1

    try:
        import cv2
    except Exception as exc:
        print("No external video player found and OpenCV is unavailable.", file=sys.stderr)
        print(f"OpenCV import error: {exc}", file=sys.stderr)
        return 1

    cap = cv2.VideoCapture(str(video_path))
    if not cap.isOpened():
        print(f"Failed to open video: {video_path}", file=sys.stderr)
        return 1

    fps = cap.get(cv2.CAP_PROP_FPS)
    delay_ms = int(round(1000.0 / fps)) if fps and fps > 0 else 33
    delay_ms = max(1, delay_ms)

    cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)

    while True:
        ok, frame = cap.read()
        if not ok:
            break
        cv2.imshow(window_name, frame)
        key = cv2.waitKey(delay_ms) & 0xFF
        if key in (27, ord("q"), ord("Q")):
            break

    cap.release()
    cv2.destroyAllWindows()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Play one video by numeric ID from data/metadata/video_id_map.csv."
    )
    parser.add_argument("video_id", help="Numeric video_id from video_id_map.csv")
    parser.add_argument(
        "--id-map",
        default=str(DEFAULT_ID_MAP),
        help="Path to video_id_map.csv",
    )
    parser.add_argument(
        "--manifest",
        default=str(DEFAULT_MANIFEST),
        help="Path to contestant_manifest.json",
    )
    parser.add_argument(
        "--data-dir",
        default=str(DEFAULT_DATA_DIR),
        help="Root folder for dataset videos",
    )
    args = parser.parse_args()

    try:
        normalized_id = _normalize_id(args.video_id)
        id_map_path = Path(args.id_map).expanduser().resolve()
        manifest_path = Path(args.manifest).expanduser().resolve()
        data_dir = Path(args.data_dir).expanduser().resolve()

        video_key = _lookup_video_key(normalized_id, id_map_path)
        entry = _load_manifest_entry(video_key, manifest_path)
        video_path = _resolve_video_path(str(entry.get("video_path", "")), data_dir)
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1

    print(f"video_id  : {normalized_id}", flush=True)
    print(f"video_key : {video_key}", flush=True)
    print(f"video     : {video_path}", flush=True)

    if _play_with_external_player(video_path):
        return 0

    return _play_with_opencv(video_path, window_name=f"run_vid: {video_key}")


if __name__ == "__main__":
    raise SystemExit(main())
