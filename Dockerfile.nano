# =============================================================================
# Dockerfile.nano — SiamRAM on Jetson Orin Nano
#
# Base image ships: torch 2.1, torchvision, TensorRT 10.x, torch_tensorrt,
# CUDA 12.2, cuDNN 8, Python 3.10, GStreamer runtime.
#
# Build:
#   docker build -f Dockerfile.nano -t siamram-nano .
#
# Run (inference):
#   docker run --runtime=nvidia \
#     -v /path/to/dataset:/data:ro \
#     -v /path/to/output:/output \
#     siamram-nano \
#     python inference.py /data/test.json public_lb /output/submission.csv
#
# Run with NVDEC hardware decode (pass device nodes through):
#   docker run --runtime=nvidia \
#     --device=/dev/nvhost-nvdec \
#     --device=/dev/nvhost-ctrl \
#     --device=/dev/nvmap \
#     -v /path/to/dataset:/data:ro \
#     -v /path/to/output:/output \
#     siamram-nano \
#     python inference.py /data/test.json public_lb /output/submission.csv
# =============================================================================

FROM nvcr.io/nvidia/l4t-pytorch:r36.2.0-pth2.1-py3

# ---------------------------------------------------------------------------
# System packages
# python3-opencv: OpenCV built with GStreamer + nvv4l2decoder for NVDEC
# gstreamer plugins: bad includes nvv4l2decoder, good/ugly for container formats
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-opencv \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python dependencies (Jetson-specific — excludes torch/torchvision/opencv)
# ---------------------------------------------------------------------------
WORKDIR /app
COPY requirements.nano.txt .
RUN pip install --no-cache-dir -r requirements.nano.txt

# ---------------------------------------------------------------------------
# Application source
# ---------------------------------------------------------------------------
COPY . .

# TRT engine cache lives outside the image so it persists across runs and
# survives image rebuilds.  Mount a host directory here at runtime:
#   -v /path/on/host/trt_cache:/app/trt_cache
ENV SIAMRAM_TRT_CACHE=/app/trt_cache

CMD ["python3", "inference.py"]
