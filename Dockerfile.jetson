# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.jetson — MTC-AIC4 submission image for Jetson Orin Nano,
# JetPack 7.2 (L4T r39.2, Ubuntu 24.04, CUDA 13.2 host, TensorRT 10.16).
#
# arm64-only image. Build ON the Jetson with plain `docker build`, or on an
# x86_64 machine through qemu:
#
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#   docker buildx build --platform linux/arm64 -f Dockerfile.jetson \
#       -t siamram-jetson --load .
#
# Run with the NVIDIA runtime (mandatory on Jetson; `--gpus all` is NOT
# supported on the Tegra iGPU):
#
#   docker run --runtime nvidia --ipc host -it siamram-jetson \
#       python inference.py test.json public_lb submission.csv
#
# Stack (each item verified against NVIDIA repos/indexes, July 2026 — see
# docs/jetson-jetpack72-docker.md for sources):
#   * Base image is the standard multi-arch CUDA image. Since CUDA 13.2 /
#     JetPack 7.2 the SBSA aarch64 toolkit covers Jetson Orin, so l4t-* base
#     images are no longer used.
#   * TensorRT 10.16.1.11-1+cuda13.2 comes from the ubuntu2404/sbsa CUDA apt
#     repo (the ubuntu2404/arm64 path does NOT carry TensorRT) and matches the
#     TensorRT 10.16 line that JetPack 7.2 ships on the device.
#   * torch 2.9.1+cu130 / torchvision 0.24.1+cu130 aarch64 wheels exist on
#     download.pytorch.org/whl/cu130 and run on JetPack 7 via the unified
#     SBSA/Jetson CUDA platform.
#   * NVDEC GStreamer elements (nvv4l2decoder, nvvidconv) come from
#     nvidia-l4t-gstreamer 39.2.0 in the JetPack 7.2 OTA repo. The debs are
#     extracted with dpkg-deb -x (no maintainer scripts) — the standard way to
#     put BSP userspace into a container.
#   * OpenCV is Ubuntu 24.04's python3-opencv 4.6.0, which is built with
#     GStreamer and FFmpeg support (pip opencv-python has neither).
# =============================================================================

# Digest-pinned so the tag can never silently move (multi-arch manifest list
# digest from nvcr.io; the arm64 image inside it is sha256:36050649ad1a...).
FROM nvcr.io/nvidia/cuda:13.0.1-runtime-ubuntu24.04@sha256:c3fde347d52d578c84fd644bc177bc7ec333feaf11550d990da4084d7612e4c7

# TensorRT pin requested by the organizers; matches JetPack 7.2 (TRT 10.16.x).
ARG TRT_VER=10.16.1.11-1+cuda13.2
# JetPack 7.2 == L4T r39.2. The BSP deb version is shared by every l4t package.
ARG L4T_SUITE=r39.2
ARG L4T_VER=39.2.0-20260601141651

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

WORKDIR /app

# --- OS layer: Python 3.12, build tools for the git dependencies, Ubuntu's
# GStreamer-enabled OpenCV (+ its matching numpy 1.26, which the cv2 ABI
# requires — do not let pip upgrade numpy to 2.x), and the GStreamer plugin
# sets used by the decode pipeline (qtdemux is in -good, the h264/h265 parsers
# used by parsebin are in -bad, gstreamer1.0-libav is the CPU decode fallback).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        python3 \
        python3-dev \
        python3-venv \
        python3-numpy \
        python3-opencv \
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-libav && \
    rm -rf /var/lib/apt/lists/*

# --- TensorRT from the CUDA sbsa repo, pinned to the organizer-specified
# version. The base image already configures the ubuntu2404/sbsa CUDA apt repo
# (adding cuda-keyring again conflicts with it), so just install.
# python3-libnvinfer provides the `tensorrt` module for the system Python
# 3.12; the venv below uses --system-site-packages to see it.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libnvinfer10=${TRT_VER} \
        libnvinfer-plugin10=${TRT_VER} \
        libnvinfer-lean10=${TRT_VER} \
        libnvinfer-dispatch10=${TRT_VER} \
        libnvonnxparsers10=${TRT_VER} \
        python3-libnvinfer=${TRT_VER} \
        python3-libnvinfer-lean=${TRT_VER} \
        python3-libnvinfer-dispatch=${TRT_VER}; \
    rm -rf /var/lib/apt/lists/*

# --- Jetson BSP userspace for NVDEC: nvv4l2decoder/nvvidconv plus the L4T
# libraries they link against. Extracted rather than installed so the l4t
# maintainer scripts (which expect a flashed Tegra device) never run. libcuda
# and the remaining driver bits are injected at run time by
# nvidia-container-toolkit (runtime: nvidia).
RUN set -eux; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL -o /etc/apt/keyrings/jetson-ota-public.asc \
        https://repo.download.nvidia.com/jetson/jetson-ota-public.asc; \
    { \
      echo "deb [signed-by=/etc/apt/keyrings/jetson-ota-public.asc] https://repo.download.nvidia.com/jetson/common ${L4T_SUITE} main"; \
      echo "deb [signed-by=/etc/apt/keyrings/jetson-ota-public.asc] https://repo.download.nvidia.com/jetson/som ${L4T_SUITE} main"; \
    } > /etc/apt/sources.list.d/nvidia-l4t.list; \
    apt-get update; \
    cd /tmp; \
    apt-get download \
        nvidia-l4t-core=${L4T_VER} \
        nvidia-l4t-nvsci=${L4T_VER} \
        nvidia-l4t-multimedia-utils=${L4T_VER} \
        nvidia-l4t-multimedia=${L4T_VER} \
        nvidia-l4t-camera=${L4T_VER} \
        nvidia-l4t-gstreamer=${L4T_VER}; \
    for deb in ./*.deb; do dpkg-deb -x "$deb" /; done; \
    rm -f ./*.deb; \
    rm -rf /var/lib/apt/lists/*; \
    echo "/usr/lib/aarch64-linux-gnu/nvidia" > /etc/ld.so.conf.d/nvidia-l4t.conf; \
    ldconfig

# --- Python env. --system-site-packages is mandatory: it is how the venv sees
# the apt-installed tensorrt bindings, cv2 (GStreamer build) and numpy 1.26.
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN python3 -m venv --system-site-packages "$VIRTUAL_ENV" && \
    pip install --no-cache-dir --upgrade \
        pip==26.1.2 setuptools==83.0.0 wheel==0.47.0

# --- PyTorch CUDA 13.0 aarch64 wheels (unified SBSA/Jetson platform).
# torch 2.9.1 pairs with torchvision 0.24.1. The cu130 index must be the
# PRIMARY index: the aarch64 torchvision 0.24.1 wheel there carries no +cu130
# local tag (that convention starts at 0.25), and with PyPI first pip would
# pick the CPU-only build of the same version. The index hosts all transitive
# deps (nvidia-* CUDA libs, triton, sympy, ...); the wheels pull their CUDA
# runtime libs as pip packages, so the runtime base image is sufficient.
# numpy stays at the apt 1.26 build (cv2 ABI).
RUN pip install --no-cache-dir \
        torch==2.9.1+cu130 \
        torchvision==0.24.1 \
        --index-url https://download.pytorch.org/whl/cu130

# --- Application dependencies. Flat, fully enumerated list installed with
# --no-deps for the same reason as requirements.jetson.txt: ultralytics,
# torchreid and friends declare opencv-python / torch, which would silently
# replace the GStreamer OpenCV and the CUDA torch wheels above.
COPY requirements.jetson7.txt ./
RUN pip install --no-cache-dir --no-deps --no-build-isolation \
        -r requirements.jetson7.txt && \
    pip install --no-cache-dir --no-deps ultralytics==8.4.45 && \
    pip install --no-cache-dir --no-deps --no-build-isolation \
        git+https://github.com/KaiyangZhou/deep-person-reid.git@f8cd150fdf77e8d9e1ed143b7f308c2c609ded50

COPY . .

# raw ONNX->TensorRT backend (auto-selected on aarch64 anyway) with the Jetson
# memory caps from docs/jetson-orin-nano-runbook.md; video capability enables
# NVDEC device injection by the container runtime.
ENV SIAMRAM_TRT_BACKEND=raw \
    SIAMRAM_TRT_WORKSPACE_MB=256 \
    SIAMRAM_TRT_TACTIC_DRAM_MB=512 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# Grader entrypoint: python inference.py <manifest.json> <split> <output.csv>
# Sanity check:      python docker/verify_stack.py
CMD ["bash"]
