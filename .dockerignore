# Keep the build context (and the resulting image) small. None of this is needed
# inside the container: the checkpoints are downloaded at run time, and the rest
# is local/dev clutter.
.git
.gitignore
__pycache__/
*.pyc
checkpoints/
outputs/
*.csv
!sample_submission.csv
.venv/
.vscode/
.idea/
data/
trt_cache/
*.log
*.mp4
*.rar
SiamRAM_Ablation_Tables.pdf
# Never let local secrets enter the build context / image (COPY . .).
.env
.env.*
*.pem
*.key
id_rsa*
*credentials*